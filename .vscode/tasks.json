{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "rm -rf dist; hatchling build; twine check dist/*",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Publish [Test]",
      "type": "shell",
      "command": "./dist/publish.sh --test",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Publish [Prod]",
      "type": "shell",
      "command": "./dist/publish.sh",
      "group": "build"
    },
    {
      "label": "Run Pytest (Python 3.10)",
      "type": "shell",
      "command": "PYENV_VERSION=3.10",
      "args": [
        "python3.10",
        "-m",
        "pip",
        "install",
        "--upgrade",
        "pip",
        "&&",
        "PYENV_VERSION=3.10",
        "python3.10",
        "-m",
        "pip",
        "install",
        "pytest",
        "-e",
        ".",
        "&&",
        "PYENV_VERSION=3.10",
        "python3.10",
        "-m",
        "pytest"
      ],
      "group": "test"
    },
    {
      "label": "Run Pytest (Python 3.11)",
      "type": "shell",
      "command": "PYENV_VERSION=3.11",
      "args": [
        "python3.11",
        "-m",
        "pip",
        "install",
        "--upgrade",
        "pip",
        "&&",
        "PYENV_VERSION=3.11",
        "python3.11",
        "-m",
        "pip",
        "install",
        "pytest",
        "-e",
        ".",
        "&&",
        "PYENV_VERSION=3.11",
        "python3.11",
        "-m",
        "pytest"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run Pytest (Python 3.12)",
      "type": "shell",
      "command": "PYENV_VERSION=3.12",
      "args": [
        "python3.12",
        "-m",
        "pip",
        "install",
        "--upgrade",
        "pip",
        "&&",
        "PYENV_VERSION=3.12",
        "python3.12",
        "-m",
        "pip",
        "install",
        "pytest",
        "-e",
        ".",
        "&&",
        "PYENV_VERSION=3.12",
        "python3.12",
        "-m",
        "pytest"
      ],
      "group": "test"
    },
    {
      "label": "Run Pytest (Python 3.13)",
      "type": "shell",
      "command": "PYENV_VERSION=3.13",
      "args": [
        "python3.13",
        "-m",
        "pip",
        "install",
        "--upgrade",
        "pip",
        "&&",
        "PYENV_VERSION=3.13",
        "python3.13",
        "-m",
        "pip",
        "install",
        "pytest",
        "-e",
        ".",
        "&&",
        "PYENV_VERSION=3.13",
        "python3.13",
        "-m",
        "pytest"
      ],
      "group": "test"
    },
    {
      "label": "Run Pytest (Python 3.14)",
      "type": "shell",
      "command": "PYENV_VERSION=3.14",
      "args": [
        "python3.14",
        "-m",
        "pip",
        "install",
        "--upgrade",
        "pip",
        "&&",
        "PYENV_VERSION=3.14",
        "python3.14",
        "-m",
        "pip",
        "install",
        "pytest",
        "-e",
        ".",
        "&&",
        "PYENV_VERSION=3.14",
        "python3.14",
        "-m",
        "pytest"
      ],
      "group": "test"
    },
    {
      "label": "Run All Pytest Versions",
      "type": "shell",
      "dependsOn": [
        "Run Pytest (Python 3.10)",
        "Run Pytest (Python 3.11)",
        "Run Pytest (Python 3.12)",
        "Run Pytest (Python 3.13)",
        "Run Pytest (Python 3.14)"
      ],
      "group": "test"
    }
  ]
}
